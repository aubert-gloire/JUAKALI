# Environment: development | test | production
NODE_ENV=development
PORT=3001

# MongoDB Atlas connection string (M0 free tier)
# Region: eu-west-1 (Frankfurt) - closest free tier to Rwanda
# Network access: 0.0.0.0/0, protected by strong DB user password
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/juakali?retryWrites=true&w=majority

# JWT secrets - generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin (locked CORS target)
APP_ORIGIN=http://localhost:5173

# Cron job protection secret
CRON_SECRET=

# AI provider configuration
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=

# Feature flags
BILLING_ENABLED=false

# Per-user AI request limit per day
AI_REQUESTS_PER_USER_PER_DAY=50

# Trial length in days (for new organizations)
TRIAL_DAYS=14

# Grace period in days after payment due
GRACE_DAYS=7

# ── Seed-time only ──────────────────────────────────────────────────────────
# These are consumed by scripts/seed.ts and never read by the running app.
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=
SHOP_NAME=
SHOP_LOCATION=
CURRENCY=RWF
TIMEZONE=Africa/Kigali
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
